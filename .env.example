# Copy this file to .env and replace the empty required values.
GITHUB_TOKEN=
GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_OWNER_TYPE=user
# BEEHAIIVE_GITHUB_DISCOVERY_CACHE_SECONDS=600
BEEHAIIVE_API_KEY=

# The launcher derives this from the owner and number when it is omitted.
# BEEHAIIVE_ALLOWED_PROJECTS=
BEEHAIIVE_REVIEW_MODE=demo
# Required for production review requests.
BEEHAIIVE_REVIEW_ACTOR=

# The launcher defaults this to the BeeHAIve checkout when it is omitted.
# BEEHAIIVE_AGENT_REPOSITORY=
# Exact linked Project repository owner/name for the worker checkout.
# BEEHAIIVE_AGENT_REPOSITORY_NAME=
# BEEHAIIVE_AGENT_TIMEOUT_SECONDS=120
# BEEHAIIVE_CODEX_EXECUTABLE=codex
# BEEHAIIVE_CODEX_MODEL=
