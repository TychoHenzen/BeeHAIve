# Copy this file to .env and replace the empty required values.
GITHUB_TOKEN=
GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_OWNER_TYPE=user
# BEEHAIIVE_GITHUB_DISCOVERY_CACHE_SECONDS=600
BEEHAIIVE_API_KEY=
# Server-side operator authorization. The dashboard uses it without displaying it.
# Optional operator-question notification target. HTTPS is required.
# BEEHAIIVE_NOTIFICATION_WEBHOOK_URL=
# BEEHAIIVE_NOTIFICATION_WEBHOOK_SECRET=

# The launcher derives this from the owner and number when it is omitted.
# BEEHAIIVE_ALLOWED_PROJECTS=
BEEHAIIVE_REVIEW_MODE=demo
# Required for production review requests.
BEEHAIIVE_REVIEW_ACTOR=
# Set to operator to enable graph review, activation, and rollback actions.
BEEHAIIVE_WORKFLOW_ACTOR=

# The launcher defaults this to the BeeHAIve checkout when it is omitted.
# BEEHAIIVE_AGENT_REPOSITORY=
# Exact linked Project repository owner/name for the worker checkout.
# BEEHAIIVE_AGENT_REPOSITORY_NAME=
# BEEHAIIVE_AGENT_TIMEOUT_SECONDS=120
# BEEHAIIVE_CODEX_EXECUTABLE=codex
# BEEHAIIVE_CODEX_MODEL=
# BEEHAIIVE_AUTONOMOUS_MODE=codex
# BEEHAIIVE_AUTONOMOUS_TIMEOUT_SECONDS=0
# BEEHAIIVE_DOD_GUARD_SKILLS=
# BEEHAIIVE_STATE_DB=.beehaiive/state.db
# BEEHAIIVE_ROUTING_DB=.beehaiive/routing.db
# BEEHAIIVE_REVIEW_DB=.beehaiive/reviews.db
# BEEHAIIVE_WORKFLOW_DB=.beehaiive/workflow.db
# BEEHAIIVE_WORKFLOW_REPOSITORY=

# The scheduler can run autonomous lifecycles without a browser session.
# Worker capacity is the maximum number of PBIs running at once.
# BEEHAIIVE_SCHEDULER_ENABLED=false
# BEEHAIIVE_SCHEDULER_POLL_INTERVAL_SECONDS=600
# BEEHAIIVE_SCHEDULER_MAX_CONCURRENCY=1
# BEEHAIIVE_WORKER_HOST_ID=stable-host-id
# BEEHAIIVE_WORKER_SLOTS=1
# BEEHAIIVE_WORKER_CAPABILITIES=codex,python
# BEEHAIIVE_WORKER_HEARTBEAT_SECONDS=30
# BEEHAIIVE_WORKER_STALE_SECONDS=90

# One central admission authority with a local SQLite database.
# BEEHAIIVE_ADMISSION_ENABLED=false
# BEEHAIIVE_ADMISSION_CAPACITY=1
