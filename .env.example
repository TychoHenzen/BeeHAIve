# Copy this file to .env to change the defaults. Every setting is optional.
# Folder that Claude Code writes session transcripts to.
BEEHAIIVE_CLAUDE_PROJECTS=
# Show sessions with activity in the last N hours (up to 720).
BEEHAIIVE_LOOKBACK_HOURS=24
BEEHAIIVE_PORT=8000
# Archon's home folder. Defaults to ARCHON_HOME, then ~/.archon.
BEEHAIIVE_ARCHON_HOME=
# Archon's server. Defaults to http://127.0.0.1:<port from server.json, or 3090>.
BEEHAIIVE_ARCHON_URL=
# The archon program. Defaults to the binary named in install.json.
BEEHAIIVE_ARCHON_BIN=
